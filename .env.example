# Telegram Bot Configuration (Server-only, NEVER expose with NEXT_PUBLIC_)
# Used when calling with the owner master NOTIFY_API_KEY or embedding src/index.ts directly
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Master API Key for owner-level /api/notify calls
NOTIFY_API_KEY=change-this-to-a-long-random-secret

# AES-256-GCM Secret for multi-tenant user API keys (tp91_live_...)
# Keep this secret private on Vercel; if omitted, falls back to NOTIFY_API_KEY
KEY_ENCRYPTION_SECRET=change-this-to-a-32-char-random-encryption-secret

# Optional custom brand label shown in message headers
# TELEGRAM_BRAND_NAME=TP91tool
