# Telegram Bot Configuration (Server-only, NEVER expose with NEXT_PUBLIC_)
# 1. Chat with @BotFather on Telegram -> /newbot -> copy Bot Token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Get your personal or group chat_id (via @userinfobot or getUpdates API)
TELEGRAM_CHAT_ID=123456789

# 3. Required if deploying the standalone /api/notify endpoint on Vercel
# Generate any long random secret string (used in header x-api-key)
NOTIFY_API_KEY=change-this-to-a-long-random-secret

# Optional custom brand label shown in message headers
# TELEGRAM_BRAND_NAME=TP91tool
